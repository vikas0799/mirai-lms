<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Clone</title>
    <link rel="stylesheet" href="style.css">
    <style>
        * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #141414;
    color: white;
    font-family: Arial, sans-serif;
    overflow-x: hidden;
}


/* ================= NAVBAR ================= */

.navbar {
    height: 70px;
    width: 100%;
    padding: 0 4%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #141414;
    position: fixed;
    top: 0;
    z-index: 1000;
}

.nav-left {
    display: flex;
    align-items: center;
    gap: 40px;
}

.logo {
    color: #e50914;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 1px;
}

nav {
    display: flex;
    gap: 20px;
}

nav a {
    color: #e5e5e5;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: #b3b3b3;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 20px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 8px;
}

.profile img {
    width: 32px;
    height: 32px;
    border-radius: 4px;
}


/* ================= HERO ================= */

.hero {
    height: 80vh;
    min-height: 500px;

    background-image:
        linear-gradient(
            90deg,
            rgba(20, 20, 20, 1) 0%,
            rgba(20, 20, 20, 0.7) 35%,
            rgba(20, 20, 20, 0.1) 70%
        ),
        url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1600&q=80");

    background-size: cover;
    background-position: center;

    position: relative;
    display: flex;
    align-items: center;
}

.hero-content {
    width: 45%;
    margin-left: 5%;
    margin-top: 100px;
    position: relative;
    z-index: 2;
}

.hero-content h1 {
    font-size: 55px;
    margin-bottom: 20px;
    letter-spacing: 2px;
}

.hero-content p {
    font-size: 18px;
    line-height: 1.5;
    margin-bottom: 25px;
}

.buttons {
    display: flex;
    gap: 15px;
}

.buttons button {
    border: none;
    padding: 12px 28px;
    font-size: 17px;
    font-weight: bold;
    border-radius: 4px;
    cursor: pointer;
    transition: 0.3s;
}

.play-btn {
    background: white;
    color: black;
}

.play-btn:hover {
    background: #cccccc;
}

.info-btn {
    background: rgba(109, 109, 110, 0.7);
    color: white;
}

.info-btn:hover {
    background: rgba(109, 109, 110, 0.4);
}


/* ================= MOVIES ================= */

main {
    margin-top: -80px;
    position: relative;
    z-index: 10;
}

.movie-section {
    margin-bottom: 40px;
    padding-left: 4%;
}

.movie-section h2 {
    margin-bottom: 15px;
    font-size: 22px;
}

.movie-row {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-right: 30px;
    padding-bottom: 10px;
}

.movie-row::-webkit-scrollbar {
    display: none;
}

.movie-card {
    min-width: 180px;
    height: 260px;
    overflow: hidden;
    border-radius: 5px;
    cursor: pointer;
    transition: transform 0.3s;
}

.movie-card:hover {
    transform: scale(1.08);
}

.movie-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 768px) {

    nav {
        display: none;
    }

    .nav-left {
        gap: 10px;
    }

    .hero-content {
        width: 80%;
    }

    .hero-content h1 {
        font-size: 35px;
    }

    .hero-content p {
        font-size: 15px;
    }

    .movie-card {
        min-width: 140px;
        height: 200px;
    }

    .nav-right {
        gap: 10px;
    }
}
    </style>
</head>
<body>

    <!-- Navbar -->
    <header class="navbar">

        <div class="nav-left">
            <h1 class="logo">NETFLIX</h1>

            <nav>
                <a href="#">Home</a>
                <a href="#">TV Shows</a>
                <a href="#">Movies</a>
                <a href="#">New & Popular</a>
                <a href="#">My List</a>
            </nav>
        </div>

        <div class="nav-right">
            <span>🔍</span>
            <span>🔔</span>

            <div class="profile">
                <img src="https://i.pravatar.cc/100?img=12" alt="Profile">
                <span>▼</span>
            </div>
        </div>

    </header>


    <!-- Hero Section -->
    <section class="hero">

        <div class="overlay"></div>

        <div class="hero-content">
            <h1>STRANGER THINGS</h1>

            <p>
                When a young boy disappears, his mother, a police chief,
                and his friends must confront terrifying supernatural forces.
            </p>

            <div class="buttons">
                <button class="play-btn">▶ Play</button>
                <button class="info-btn">ⓘ More Info</button>
            </div>
        </div>

    </section>


    <!-- Movies -->
    <main>

        <!-- Row 1 -->
        <section class="movie-section">
            <h2>Popular on Netflix</h2>

            <div class="movie-row">

                <div class="movie-card">
                    <img src="https://image.tmdb.org/t/p/w500/q719jXXEzOoYaps6babgKnONONX.jpg">
                </div>

                <div class="movie-card">
                    <img src="https://image.tmdb.org/t/p/w500/5qGIxdEO841C0tdY8vOdLoRVrr0.jpg">
                </div>

                <div class="movie-card">
                    <img src="https://image.tmdb.org/t/p/w500/1gE4U3y2cK3bOeN7k7d9mB8u4lD.jpg">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=1">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=2">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=3">
                </div>

            </div>
        </section>


        <!-- Row 2 -->
        <section class="movie-section">
            <h2>Trending Now</h2>

            <div class="movie-row">

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=4">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=5">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=6">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=7">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=8">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=9">
                </div>

            </div>
        </section>


        <!-- Row 3 -->
        <section class="movie-section">
            <h2>Continue Watching</h2>

            <div class="movie-row">

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=10">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=11">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=12">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=13">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=14">
                </div>

                <div class="movie-card">
                    <img src="https://picsum.photos/300/450?random=15">
                </div>

            </div>
        </section>

    </main>

</body>
</html>